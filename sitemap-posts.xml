---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
{%- endfor %}
{%- for p in site.html_pages %}
  {%- assign u = p.url %}
  {%- assign skip = false %}
  {%- if p.sitemap == false or u == '/404.html' or u contains '/page' or u contains '/categories' or u contains '/tags' or u == '/search/' %}
    {%- assign skip = true %}
  {%- endif %}
  {%- comment %} Empty collection stubs (no markdown body) add nothing to discovery. {%- endcomment %}
  {%- if p.content.size < 200 %}
    {%- assign skip = true %}
  {%- endif %}
  {%- unless skip %}
  <url>
    <loc>{{ u | absolute_url }}</loc>
    {%- if p.last_modified_at %}<lastmod>{{ p.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {%- endunless %}
{%- endfor %}
</urlset>
